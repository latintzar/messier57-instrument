#N canvas 80 40 1120 850 12;
#X text 25 15 MESSIER '57 — playable Pd edition;
#X text 25 40 H head / R rim / K kick / hold S to loosen snares. Enable DSP before playing.;
#X obj 25 80 instrument;
#X obj 850 80 loadbang;
#X msg 850 110 \; pd dsp 1;
#X msg 850 150 0.6;
#X obj 930 150 s messier-tuning;
#X msg 850 185 0.8;
#X obj 930 185 s messier-rattle;
#X msg 850 220 0.6;
#X obj 930 220 s messier-damping;
#X obj 25 120 catch~ messier-native-out;
#X obj 25 150 *~;
#X obj 25 185 dac~ 1 2;
#X obj 210 110 hsl 140 18 0 1 0 0 empty empty Volume 0 -9 0 12 #e5e7da #293a30 #293a30 0 1;
#X msg 850 255 0.35;
#X obj 760 290 array define messier-head;
#X msg 600 314 read -resize head-excitation.wav messier-head;
#X obj 600 338 soundfiler;
#X obj 760 340 array define messier-rim;
#X msg 600 364 read -resize rim-excitation.wav messier-rim;
#X obj 600 388 soundfiler;
#X obj 760 390 array define messier-kick;
#X msg 600 414 read -resize kick-excitation.wav messier-kick;
#X obj 600 438 soundfiler;
#X obj 25 250 bng 24 250 50 0 empty empty Head 0 -10 0 12 #e5e7da #293a30 #293a30;
#X msg 25 285 0.65;
#X obj 25 320 s messier-head;
#X obj 25 370 r messier-head;
#X obj 25 400 t b f;
#X obj 25 430 tabplay~ messier-head;
#X obj 25 460 *~;
#X obj 25 490 *~ 1;
#X obj 25 520 r messier-sensing;
#X obj 25 550 expr $f1 != 1;
#X obj 25 590 throw~ messier-demo-snare;
#X obj 215 250 bng 24 250 50 0 empty empty Rim 0 -10 0 12 #e5e7da #293a30 #293a30;
#X msg 215 285 0.65;
#X obj 215 320 s messier-rim;
#X obj 215 370 r messier-rim;
#X obj 215 400 t b f;
#X obj 215 430 tabplay~ messier-rim;
#X obj 215 460 *~;
#X obj 215 490 *~ 1;
#X obj 215 520 r messier-sensing;
#X obj 215 550 expr $f1 != 0;
#X obj 215 590 throw~ messier-demo-snare;
#X obj 405 250 bng 24 250 50 0 empty empty Kick 0 -10 0 12 #e5e7da #293a30 #293a30;
#X msg 405 285 0.65;
#X obj 405 320 s messier-kick;
#X obj 405 370 r messier-kick;
#X obj 405 400 t b f;
#X obj 405 430 tabplay~ messier-kick;
#X obj 405 460 *~;
#X obj 405 590 throw~ messier-demo-kick;
#X obj 25 650 key;
#X obj 25 680 sel 104 114 107 115;
#X msg 25 715 0.65;
#X obj 25 745 s messier-head;
#X msg 125 715 0.65;
#X obj 125 745 s messier-rim;
#X msg 225 715 0.65;
#X obj 225 745 s messier-kick;
#X msg 330 715 1;
#X obj 330 745 s messier-pull;
#X obj 470 650 keyup;
#X obj 470 680 sel 115;
#X msg 470 715 0;
#X obj 610 650 r messier-pull;
#X obj 610 680 expr 0.8*(1-$f1);
#X obj 610 715 s messier-rattle;
#X obj 210 170 hradio 22 1 0 3 empty empty Head_-_Rim_-_All 0 -10 0 12 #e5e7da #293a30 #293a30 0;
#X obj 210 205 s messier-sensing;
#X msg 850 280 2;
#X text 600 500 adc~ 1 is a live exciter input. Input 2 is not sent to the kick.;
